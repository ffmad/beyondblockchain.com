# Relative SQLite paths resolve from apps/api for both Prisma and NestJS.
DATABASE_URL=file:./prisma/dev.db
HOST=127.0.0.1
PORT=3000
# Slack incoming webhook for the contact form (https://hooks.slack.com/services/…). Unset: messages wait in the database.
SLACK_WEBHOOK_CONTACT=
# Behind a reverse proxy, e.g. "loopback", so the contact form's rate limit sees visitors' addresses.
TRUST_PROXY=
# Anthropic API key: Claude adds notes (summary, kind, spam flag, draft reply) to contact messages. Unset: no notes.
ANTHROPIC_API_KEY=
# Claude model for those notes (default claude-opus-5-5).
CONTACT_TRIAGE_MODEL=

# The site's assistant: a small sentence model (about 120 MB) downloaded on first start. "off" turns it off; the
# chat then answers with keyword matching. ASSISTANT_MODEL_DIR keeps the model somewhere persistent.
ASSISTANT_MODEL=
ASSISTANT_MODEL_DIR=
